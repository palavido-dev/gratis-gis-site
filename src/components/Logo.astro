// The GratisGIS mark: a G drawn as two contour rings around a point.
// Decorative: always next to the word "GratisGIS".
interface Props {
  size?: number;
}
const { size = 30 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
  <path
    d="M36.73 11.27A18 18 0 1 0 42 24H32"
    stroke="#0B6E69"
    stroke-width="3.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M32.49 15.51A12 12 0 1 0 36 24"
    stroke="#0B6E69"
    stroke-width="3.6"
    stroke-linecap="round"
    opacity="0.55"></path>
  <circle cx="24" cy="24" r="3.4" fill="#0B6E69"></circle>
</svg>
