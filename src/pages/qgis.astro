// Landing page for the QGIS plugin. Facts are checked against the
// plugin's listing on plugins.qgis.org and its repository.
import Base from '../layouts/Base.astro';
import { DEMO_URL, QGIS_PLUGIN_URL } from '../lib/site';

const PLUGIN_LISTING = 'https://plugins.qgis.org/plugins/gratisgis_qgis/';
---

<Base
  title="QGIS plugin: publish layers and maps to the web | GratisGIS"
  description="Connect QGIS to a self-hosted web GIS portal. Browse portal layers, publish layers and whole projects as web maps, and push edits back. Free and open source."
  path="/qgis/"
  breadcrumbs={[{ name: 'QGIS plugin', path: '/qgis/' }]}
>
  <article class="wrap prose">
    <p class="eyebrow">QGIS</p>
    <h1>Publish from QGIS to a web GIS you host yourself</h1>
    <p>
      GratisGIS is an open source GIS portal that runs on your own server. Its plugin for QGIS
      lets analysts keep working in the desktop tool they know while the portal handles sharing,
      web maps, dashboards and field collection. The plugin is free, open source and listed in
      the official QGIS plugin repository.
    </p>

    <h2>What the plugin does</h2>
    <ul>
      <li>
        <strong>Browse and search the portal.</strong> Portal items appear in the QGIS Browser
        panel. Drag a data layer or a map onto the canvas.
      </li>
      <li>
        <strong>Publish layers.</strong> Send a vector layer to the portal as a data layer. Publish
        PMTiles, GeoTIFF or MBTiles as a tile layer.
      </li>
      <li>
        <strong>Publish a whole project.</strong> Turn the current QGIS project into a portal map
        that anyone you share it with can open in a browser.
      </li>
      <li>
        <strong>Edit in QGIS.</strong> Change features in a portal layer and push the edits back.
      </li>
      <li>
        <strong>Work offline.</strong> Clone a layer for offline use when you are away from the
        network.
      </li>
      <li>
        <strong>Private layers work too.</strong> Sign in once with your portal account. Layers
        shared only with you or your organization draw on the canvas.
      </li>
    </ul>

    <h2>Install it</h2>
    <ol>
      <li>In QGIS, open Plugins, then Manage and Install Plugins.</li>
      <li>Search for “GratisGIS” and choose Install.</li>
      <li>Enter your portal’s address and sign in.</li>
    </ol>
    <p>
      It needs QGIS 3.34 or newer and has no extra Python dependencies. See the{' '}
      <a href={PLUGIN_LISTING}>plugin listing on plugins.qgis.org</a> or the{' '}
      <a href={QGIS_PLUGIN_URL}>source on GitHub</a>.
    </p>

    <h2>No plugin? Open standards work as well</h2>
    <p>
      Every layer in the portal is also served through OGC APIs, so QGIS and other clients can
      connect with no plugin at all.
    </p>
    <ul>
      <li><strong>OGC API Features</strong> for layers as features.</li>
      <li><strong>OGC API Tiles</strong> for vector and raster tiles.</li>
      <li><strong>OGC API Styles</strong> for layer styling.</li>
      <li><strong>OGC API Records</strong> for a searchable catalog of portal items.</li>
    </ul>

    <h2>You need a portal first</h2>
    <p>
      The plugin connects to a GratisGIS portal. Look around the public demo, then install your
      own on one Linux server with Docker. Collected field data from the{' '}
      <a href="/field-data-collection/">offline field app</a> shows up in QGIS as soon as it
      syncs.
    </p>

    <div class="cta-row">
      <a class="btn btn-primary btn-lg" href={DEMO_URL}>Open the demo</a>
      <a class="btn btn-secondary btn-lg" href="/install/">Install a portal</a>
    </div>
  </article>
</Base>
