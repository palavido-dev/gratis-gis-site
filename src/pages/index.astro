---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Home page. Facts here are checked against README.md, CHANGELOG.md,
// the code and the public demo's sample workspace. Release facts
// (version, dates, counts) come from GitHub at build time, see
// src/lib/releases.ts.
//
// Writing rules for this page: plain sentences, real nouns and
// numbers from the demo, say where ArcGIS Online is ahead. No slogan
// triads, no invented sample data.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import elkins from '../assets/shots/elkins-3d-map.webp';
import bridges from '../assets/shots/bridges-dashboard.webp';
import water from '../assets/shots/water-quality-dashboard.webp';
import { DEMO_URL, QGIS_PLUGIN_URL, REPO_URL, repoFile } from '../lib/site';
import { getReleaseData } from '../lib/releases';

const releases = await getReleaseData();

const shotFormats = ['avif', 'webp'] as const;
const storyWidths = [600, 900, 1200];
const storySizes = '(min-width: 1200px) 640px, (min-width: 900px) 52vw, 100vw';

// Counts from the Randolph County, West Virginia sample workspace on
// the public demo (the same data as "Load sample data" in the app).
const demoNumbers = [
  { value: '23,915', label: 'tax parcels' },
  { value: '188', label: 'highway bridges with condition ratings' },
  { value: '285,788', label: 'water quality readings, 1995 to 2019' },
  { value: '30 years', label: 'of county storm events' },
];

const comparison = [
  {
    topic: 'Where it runs',
    us: 'Your own Linux server or NAS',
    them: 'Esri’s cloud',
  },
  {
    topic: 'Licensing',
    us: 'Free and open source. No per-user fees.',
    them: 'Per user, by user type, plus credits for some services',
  },
  {
    topic: 'Maps, layers and sharing',
    us: 'Yes, sharing by group, organization, public link or map area',
    them: 'Yes, with a much larger set of tools',
  },
  {
    topic: 'Field collection',
    us: 'Offline field app that runs in the phone’s browser',
    them: 'Field Maps and Survey123 native apps',
  },
  {
    topic: 'Dashboards and apps',
    us: 'Dashboards and an app builder',
    them: 'Dashboards, Experience Builder and more',
  },
  {
    topic: 'Sign-in',
    us: 'Keycloak with OpenID Connect',
    them: 'ArcGIS accounts and enterprise single sign-on',
  },
  {
    topic: 'Track record',
    us: `First stable release ${releases.v1Date}`,
    them: 'Decades of products, training and partners',
  },
];

const faq = [
  {
    q: 'Is it really free?',
    a: 'The software is. It is open source under the AGPL, with no license keys or per-user fees. You pay for the server you run it on and the time to look after it.',
  },
  {
    q: 'What do I need to run it?',
    a: 'One Linux server with Docker, or a TrueNAS or Dockge box. The public demo runs on 4 CPU cores and 8 GB of RAM. Installing is one command, and the install guide shows each step if you would rather run them yourself.',
  },
  {
    q: 'Can I move our ArcGIS Online content over?',
    a: 'There is an importer for hosted feature layers and web maps, and the portal reads the formats GDAL reads. Try it with one team before moving everything.',
  },
  {
    q: 'What happens to our data if the project stops?',
    a: 'It is already on your server, in PostgreSQL with PostGIS, and readable through standard OGC APIs. Nothing about it depends on this project continuing.',
  },
  {
    q: 'Who maintains it?',
    a: 'Matt Palavido maintains GratisGIS and reviews every change before it merges. Bug reports and pull requests are welcome on GitHub, and questions go to GitHub Discussions.',
  },
];
---

<Base path="/">
  <section class="hero" aria-labelledby="hero-title">
    <svg class="hero-contours" aria-hidden="true" viewBox="0 0 1440 560" preserveAspectRatio="xMidYMid slice">
      <g fill="none" stroke="var(--contour)" stroke-width="1.2">
        <path d="M980 60c120-40 260 10 330 90s40 190-60 230-250 20-330-50-60-230 60-270z"></path>
        <path d="M1010 110c90-28 190 8 240 66s30 140-44 168-182 14-240-36-44-170 44-198z"></path>
        <path d="M1040 160c60-18 124 6 158 44s20 92-30 110-120 10-158-24-28-112 30-130z"></path>
        <path d="M1075 205c30-9 62 3 79 22s10 46-15 55-60 5-79-12-14-56 15-65z"></path>
        <path d="M-40 420c160-60 330-40 450 30s260 90 420 40 330-110 470-60 200 120 200 120"></path>
        <path d="M-40 470c160-55 330-35 450 30s260 85 420 38 330-100 470-55 200 110 200 110"></path>
      </g>
    </svg>
    <div class="wrap hero-inner">
      <p class="hero-meta">Open source · runs on your own server · v{releases.currentVersion}</p>
      <h1 id="hero-title">A GIS portal your organization owns, down to the server it runs on.</h1>
      <p class="lead">
        GratisGIS covers the everyday work most teams use ArcGIS Online for: web maps, data layers,
        forms, dashboards and an offline field app. You install it on one Linux server, add as many
        people as you need, and the only bill is the server.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={DEMO_URL}>Open the demo</a>
        <a class="btn btn-link btn-lg" href="/install/">Read the install guide</a>
      </div>
    </div>
  </section>

  <section class="wrap" aria-label="The public demo">
    <figure class="shot">
      <Picture
        src={elkins}
        formats={[...shotFormats]}
        fallbackFormat="webp"
        widths={[720, 1200, 1800, 2400]}
        sizes="(min-width: 1200px) 1152px, 100vw"
        alt="Elkins, West Virginia in GratisGIS, tilted in 3D, with each building drawn at its measured height over a hillshade."
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>Elkins, West Virginia. Every mapped building at the height measured by a 2018 lidar flight.</span>
        <a href={DEMO_URL}>Open the demo, no sign-in needed to view it</a>
      </figcaption>
    </figure>
  </section>

  <section class="wrap numbers" aria-labelledby="numbers-label">
    <p class="numbers-label" id="numbers-label">
      What is loaded in the public demo, from Randolph County, West Virginia
    </p>
    <dl>
      {
        demoNumbers.map((n) => (
          <div>
            <dt>{n.value}</dt>
            <dd>{n.label}</dd>
          </div>
        ))
      }
    </dl>
    <p class="note">
      Shared test accounts are on the demo’s sign-in page. Everything resets each night, so try
      whatever you like.
    </p>
  </section>

  <section class="wrap section" id="tour" aria-labelledby="tour-title">
    <h2 id="tour-title">What people do with it</h2>

    <div class="story">
      <div class="story-copy">
        <h3>Find the bridges that need attention first</h3>
        <p>
          The bridges dashboard reads straight from a data layer. Filter by condition or decade
          built and the counts, charts and map all follow. When someone edits the layer, the
          dashboard is already current.
        </p>
        <a class="more" href={DEMO_URL}>See it on the demo</a>
      </div>
      <div class="story-media">
        <figure class="shot">
          <Picture
            src={bridges}
            formats={[...shotFormats]}
            fallbackFormat="webp"
            widths={storyWidths}
            sizes={storySizes}
            alt="Randolph County bridges dashboard with condition counts, a chart by decade built and a map of bridges."
          />
        </figure>
      </div>
    </div>

    <div class="story">
      <div class="story-copy">
        <h3>Send a crew somewhere without signal</h3>
        <p>
          Before they leave, the crew downloads the area they will work in. They collect points,
          photos and form answers all day on a phone, and the edits sync when they are back in
          range. The field app runs in the phone’s browser, so there is nothing to install from an
          app store.
        </p>
      </div>
      <div class="story-media">
        <ol class="steps">
          <li><span class="when">Before leaving</span><strong>Download an area</strong></li>
          <li><span class="when">In the field</span><strong>Collect without signal</strong></li>
          <li><span class="when">Back in range</span><strong>Edits sync on their own</strong></li>
        </ol>
      </div>
    </div>

    <div class="story">
      <div class="story-copy">
        <h3>Put 25 years of water samples in front of the public</h3>
        <p>
          1,175 monitoring sites, each reading compared with its drinking water limit. Pan the map
          and every number on the page answers for what you can see. It is shared publicly, so
          anyone with the link can use it.
        </p>
        <a class="more" href={DEMO_URL}>See it on the demo</a>
      </div>
      <div class="story-media">
        <figure class="shot">
          <Picture
            src={water}
            formats={[...shotFormats]}
            fallbackFormat="webp"
            widths={storyWidths}
            sizes={storySizes}
            alt="Water quality dashboard with a map of monitoring sites, counters and charts."
          />
        </figure>
      </div>
    </div>

    <div class="story">
      <div class="story-copy">
        <h3>Keep working in QGIS</h3>
        <p>
          Analysts sign in from the GratisGIS plugin for QGIS and work with portal layers in the
          desktop tool they already know. Other tools read the same layers through open standards,
          with no custom connector.
        </p>
        <a class="more" href={QGIS_PLUGIN_URL}>Get the QGIS plugin</a>
      </div>
      <div class="story-media">
        <ul class="standards" aria-label="Open standards the portal serves">
          <li>OGC API Features<span>Layers as features, for QGIS and other clients</span></li>
          <li>OGC API Tiles<span>Vector and raster tiles</span></li>
          <li>OGC API Styles<span>Layer styling</span></li>
          <li>OGC API Records<span>A searchable catalog of portal items</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="compare" id="compare" aria-labelledby="compare-title">
    <div class="wrap compare-inner">
      <h2 id="compare-title">How it compares with ArcGIS Online</h2>
      <p class="section-intro">
        Most people who find GratisGIS already pay for ArcGIS Online. Here is an honest side by
        side, including where Esri is ahead.
      </p>
      <div class="table-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Topic</span></th>
              <th scope="col">GratisGIS</th>
              <th scope="col">ArcGIS Online</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr>
                  <th scope="row">{row.topic}</th>
                  <td>{row.us}</td>
                  <td class="them">{row.them}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="caveat">
        If you rely on Survey123’s advanced features, Experience Builder, or enterprise single
        sign-on beyond OpenID Connect, stay where you are for now. Better to know that before you
        install anything.
      </p>
    </div>
  </section>

  <section class="wrap split" aria-labelledby="who-title">
    <h2 id="who-title">Who it is for</h2>
    <div class="split-body audiences">
      <div>
        <h3>Small GIS teams</h3>
        <p>Counties, cities, utilities and nonprofits where the editors outnumber the licenses.</p>
      </div>
      <div>
        <h3>Consultants</h3>
        <p>Firms that collect field data for clients and would rather send a link than a zip file.</p>
      </div>
      <div>
        <h3>IT departments</h3>
        <p>
          People who need to know where the data lives, who can sign in, and how upgrades work. The{' '}
          <a href={repoFile('SECURITY.md')}>security policy</a> and{' '}
          <a href={repoFile('ARCHITECTURE.md')}>architecture notes</a> answer those in detail.
        </p>
      </div>
    </div>
  </section>

  <section class="wrap section" id="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions people ask</h2>
    <div class="faq-list">
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <section class="closing" id="changelog" aria-labelledby="closing-title">
    <div class="wrap closing-inner">
      <div class="closing-copy">
        <p class="release-line">
          Latest release{' '}
          <a href={`${REPO_URL}/releases/tag/v${releases.currentVersion}`}>v{releases.currentVersion}</a>,{' '}
          <time datetime={releases.currentIsoDate}>{releases.currentDate}</time>. {releases.releaseCount}{' '}
          releases since {releases.firstReleaseMonth}, each with <a href={repoFile('CHANGELOG.md')}>public notes</a>.
        </p>
        <h2 id="closing-title">Look around the demo before you install anything.</h2>
      </div>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={DEMO_URL}>Open the demo</a>
        <a class="btn btn-link btn-lg" href="/install/">Install guide</a>
      </div>
    </div>
  </section>
</Base>
